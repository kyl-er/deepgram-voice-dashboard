# OPTIONAL. The server reads DEEPGRAM_API_KEY from your OS environment first
# (~/.bashrc export on Linux/macOS, `setx` on Windows). Use this file only if
# you'd rather not set a system variable: copy to .env and fill in.
DEEPGRAM_API_KEY=your_primary_key_here
DEEPGRAM_V2_API_KEY=
DEEPGRAM_BASE_URL=https://api.deepgram.com
PORT=8787
# HOST=0.0.0.0   # default 127.0.0.1 — see "Security" in README
