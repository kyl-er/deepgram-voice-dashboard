{
  "name": "deepgram-voice-dashboard",
  "version": "1.0.0",
  "description": "DG//VOX multi-tab Deepgram console: Voice Agent (home), Simple Voice (STT+TTS), Text Intelligence (/v1/read)",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build": "esbuild public/deepgram-agent.js --bundle --format=esm --platform=browser --target=es2022 --outfile=public/deepgram-agent.bundle.js --log-level=info"
  },
  "dependencies": {
    "@deepgram/agents": "^0.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "playwright-core": "^1.63.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
